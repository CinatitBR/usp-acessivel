# ==============================================================================
# API & Backend Configuration
# ==============================================================================

# Main backend API URL (e.g., https://example.com - DO NOT include a trailing slash)
BASE_URL=your_base_url_here

# Object storage URL for user-uploaded media (e.g., Cloudflare R2 - DO NOT include a trailing slash)
STORAGE_BASE_URL=your_storage_base_url_here


# ==============================================================================
# Third-Party Integrations
# ==============================================================================

# OpenRouteService API Key (Get yours at: https://openrouteservice.org)
# Note: Ensure this key has restriction policies enabled in the ORS dashboard.
OPEN_ROUTE_SERVICE_API_KEY=your_open_route_service_key_here
